                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "PBF227D336EFBEDC9"
                      },
                      "spec": {
                        "query": "perf =\r\n  from(bucket: \"${bucket}\")\r\n    |> range(start: -30d)\r\n    |> filter(fn: (r) => r._measurement == \"fl_inference_summary\")\r\n    |> filter(fn: (r) => r.eval_id == \"${eval_id}\")\r\n    |> filter(fn: (r) => r.train_run_id == \"${train_run_id}\")\r\n    |> filter(fn: (r) =>\r\n      r._field == \"technical_success_rate\" or\r\n      r._field == \"top1_accuracy\" or\r\n      r._field == \"throughput_req_per_sec\" or\r\n      r._field == \"latency_ms_p95\" or\r\n      r._field == \"model_inference_ms_p95\"\r\n    )\r\n    |> group(columns: [\r\n      \"eval_id\",\r\n      \"train_run_id\",\r\n      \"inference_node\",\r\n      \"benchmark_node\",\r\n      \"concurrency\",\r\n      \"batch_size\",\r\n      \"_field\"\r\n    ])\r\n    |> last()\r\n\r\nenergy =\r\n  from(bucket: \"${bucket}\")\r\n    |> range(start: -30d)\r\n    |> filter(fn: (r) => r._measurement == \"fl_inference_energy_total\")\r\n    |> filter(fn: (r) => r.eval_id == \"${eval_id}\")\r\n    |> filter(fn: (r) => r.train_run_id == \"${train_run_id}\")\r\n    |> filter(fn: (r) =>\r\n      r._field == \"total_energy_wh\" or\r\n      r._field == \"total_joule_per_request\" or\r\n      r._field == \"total_wh_per_1000_requests\" or\r\n      r._field == \"total_avg_power_w\"\r\n    )\r\n    |> group(columns: [\r\n      \"eval_id\",\r\n      \"train_run_id\",\r\n      \"inference_node\",\r\n      \"benchmark_node\",\r\n      \"concurrency\",\r\n      \"batch_size\",\r\n      \"_field\"\r\n    ])\r\n    |> last()\r\n\r\nunion(tables: [perf, energy])\r\n  |> group(columns: [\r\n    \"eval_id\",\r\n    \"train_run_id\",\r\n    \"inference_node\",\r\n    \"benchmark_node\",\r\n    \"concurrency\",\r\n    \"batch_size\"\r\n  ])\r\n  |> pivot(\r\n    rowKey: [\r\n      \"eval_id\",\r\n      \"train_run_id\",\r\n      \"inference_node\",\r\n      \"benchmark_node\",\r\n      \"concurrency\",\r\n      \"batch_size\"\r\n    ],\r\n    columnKey: [\"_field\"],\r\n    valueColumn: \"_value\"\r\n  )\r\n  |> map(fn: (r) => ({\r\n    \"Eval ID\": r.eval_id,\r\n    \"Inference Node\": r.inference_node,\r\n    \"Benchmark Node\": r.benchmark_node,\r\n    \"Concurrency\": r.concurrency,\r\n    \"Success [%]\": if exists r.technical_success_rate then r.technical_success_rate * 100.0 else 0.0,\r\n    \"Top-1 Accuracy [%]\": if exists r.top1_accuracy then r.top1_accuracy * 100.0 else 0.0,\r\n    \"Durchsatz [req/s]\": if exists r.throughput_req_per_sec then r.throughput_req_per_sec else 0.0,\r\n    \"p95-Latenz [ms]\": if exists r.latency_ms_p95 then r.latency_ms_p95 else 0.0,\r\n    \"Model p95 [ms]\": if exists r.model_inference_ms_p95 then r.model_inference_ms_p95 else 0.0,\r\n    \"Energie [mWh]\": if exists r.total_energy_wh then r.total_energy_wh * 1000.0 else 0.0,\r\n    \"Joule/Request\": if exists r.total_joule_per_request then r.total_joule_per_request else 0.0,\r\n    \"Wh/1000 Requests\": if exists r.total_wh_per_1000_requests then r.total_wh_per_1000_requests else 0.0,\r\n    \"Ø Leistung [W]\": if exists r.total_avg_power_w then r.total_avg_power_w else 0.0\r\n  }))"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
