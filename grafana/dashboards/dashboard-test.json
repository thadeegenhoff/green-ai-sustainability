                      "spec": {
                        "query": "from(bucket: \"${bucket}\")\r\n  |> range(start: -10m)\r\n  |> filter(fn: (r) => r._measurement == \"shelly_plug\")\r\n  |> filter(fn: (r) => r._field == \"power_w\")\r\n  |> group(columns: [\"device\"])\r\n  |> last()\r\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])"
                      }
                    },
                    "refId": "A",
